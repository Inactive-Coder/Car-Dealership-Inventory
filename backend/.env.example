# Copy to backend/.env for local development; use unique random secrets outside local use.
DATABASE_URL=postgresql+psycopg://dealership:change-me@localhost:5432/dealership
# Set this only to a separate database whose name ends in _test before integration tests.
TEST_DATABASE_URL=postgresql+psycopg://dealership:change-me@localhost:5432/dealership_test
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
